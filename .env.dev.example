# Template only. Copy on VDS to /var/www/mskba-dev-next/.env and fill secrets locally.
APP_NAME=MSKBA_DEV
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://dev.mskba.ru
APP_THEME=mskba_app
APP_KEY=
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=mskba_dev
DB_USERNAME=mskba_dev
DB_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CLIENT=phpredis
CACHE_STORE=redis
SESSION_DRIVER=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
DEV_NGINX_PORT=8001
# Never use production tokens or webhook endpoints in staging.
TELEGRAM_UPDATES_TRANSPORT=disabled

# Default staging safety: do not deliver mail or call live providers.
MAIL_MAILER=log
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
OPENAI_API_KEY=
VK_ID_APP_ID=
