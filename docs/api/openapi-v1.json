    "/api/v1/venues": {
      "get": {
        "tags": [
          "Площадки"
        ],
        "summary": "Каталог опубликованных площадок с фильтрами",
        "operationId": "Listpublicvenues",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Page size",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque cursor from meta.next_cursor",
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Тип площадки (те же значения, что на сайте).",
            "schema": {
              "type": "string",
              "enum": [
                "sports_hall",
                "school",
                "university",
                "sports_complex",
                "arena",
                "street_court"
              ]
            },
            "example": "street_court"
          },
          {
            "name": "operational_status",
            "in": "query",
            "required": false,
            "description": "Текущее состояние: работает либо временно закрыта. Не является статусом модерации (публикуются только confirmed).",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "temporarily_closed"
              ]
            },
            "example": "active"
          },
          {
            "name": "access",
            "in": "query",
            "required": false,
            "description": "Условия доступа: free = без оплаты и предварительного подтверждения; paid = требует оплаты; approval = требует подтверждения. paid и approval могут пересекаться.",
            "schema": {
              "type": "string",
              "enum": [
                "free",
                "paid",
                "approval"
              ]
            },
            "example": "free"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Поиск по названию, адресу и краткому описанию: все слова должны совпасть; не более 100 символов.",
            "schema": {
              "type": "string",
              "maxLength": 100
            },
            "example": "Москва"
          }
        ],
        "responses": {
          "200": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VenuePage"
                }
              }
            }
          },
          "422": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "429": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "description": "Only confirmed, non-deleted venues. Filters match the web catalog and are applied in SQL before cursor pagination. Empty/omitted filters return all public venues. The next-page URL retains filters."
      }
    },
    "/api/v1/venues/{venue}": {
      "get": {
        "tags": [
          "Площадки"
        ],
        "summary": "Получить опубликованную площадку по ID",
        "description": "Public, read-only. Shares visibility and fields with GET /api/v1/venues. Returns 404 for missing, unconfirmed, blocked or soft-deleted venues.",
        "operationId": "getPublicVenue",
        "security": [],
        "parameters": [
          {
            "name": "venue",
            "in": "path",
            "required": true,
            "description": "Positive numeric MSKBA venue ID (not a cursor or slug).",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Площадка найдена",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VenueDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "Нет опубликованной площадки с таким ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "message": "Площадка не найдена."
                }
              }
            }
          },
          "429": {
            "description": "Превышен лимит запросов (60/мин)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/internal/page-builder/{kind}/{key}": {
