{
  "openapi": "3.1.0",
  "info": {
    "title": "MSKBA REST API v1",
    "version": "1.0.0",
    "description": "Versioned REST contract for implemented MSKBA endpoints only. Opened in DEV Swagger UI; GraphQL remains separate. This spec includes public feeds and first-party Sanctum authentication. Internal Page Builder operations are available ONLY on dev.mskba.ru and require dedicated short-lived superadmin tokens; they are not part of the mobile-client contract."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current MSKBA host (DEV for testing)"
    }
  ],
  "tags": [
    {
      "name": "Площадки"
    },
    {
      "name": "Авторизация"
    },
    {
      "name": "Профиль"
    },
    {
      "name": "Главная страница"
    },
    {
      "name": "Внутренний API · Page Builder (DEV)",
      "description": "Только DEV/staging; отдельный временный токен superadmin, права Filament, контроль SHA-256, аудит. Не использовать обычный мобильный токен."
    }
  ],
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Авторизация"
        ],
        "summary": "Login with existing MSKBA account",
        "operationId": "login",
        "description": "Rate limit 5/minute; returns a personal Sanctum token, valid for 30 days.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "429": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
