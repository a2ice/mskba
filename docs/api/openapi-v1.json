{
  "openapi": "3.1.0",
  "info": {
    "title": "MSKBA REST API v1",
    "version": "1.0.0",
    "description": "Versioned REST contract for implemented MSKBA endpoints only. Opened in DEV Swagger UI; GraphQL remains separate. This spec includes public feeds and first-party Sanctum authentication."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current MSKBA host (DEV for testing)"
    }
  ],
  "tags": [
    {
      "name": "Площадки"
    },
    {
      "name": "Авторизация"
    },
    {
      "name": "Профиль"
    },
    {
      "name": "Главная страница"
    }
  ],
  "paths": {
    "/api/v1/venues": {
      "get": {
        "tags": [
          "Площадки"
        ],
        "summary": "List public venues",
        "operationId": "Listpublicvenues",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Page size",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque cursor from meta.next_cursor",
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "200": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VenuePage"
                }
              }
            }
          },
          "422": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "429": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/get_venues": {
      "get": {
        "tags": [
          "Площадки"
        ],
        "summary": "Legacy get venues",
        "operationId": "Legacygetvenues",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Page size",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque cursor from meta.next_cursor",
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "200": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VenuePage"
                }
              }
            }
          },
          "422": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "429": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "deprecated": true
      }
    },
    "/api/v1/home/venues-map": {
      "get": {
        "tags": [
          "Главная страница"
        ],
        "summary": "Homepage venues map",
        "operationId": "Homepagevenuesmap",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Page size",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque cursor from meta.next_cursor",
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "200": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MapPage"
                }
              }
            }
          },
          "422": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "429": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/home/tournaments-scene": {
      "get": {
        "summary": "Homepage tournaments scene",
        "tags": [
          "Главная страница"
        ],
        "operationId": "getHomeTournamentsScene",
        "responses": {
          "200": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TournamentsScene"
                }
              }
            }
          },
          "429": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Авторизация"
        ],
        "summary": "Login with existing MSKBA account",
        "operationId": "login",
        "description": "Rate limit 5/minute; returns a personal Sanctum token, valid for 30 days.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "429": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "Профиль"
        ],
        "summary": "Own user profile",
        "operationId": "getMe",
        "description": "Requires Bearer token with profile:read; website session is not an API credential.",
        "security": [
          {
            "sanctumBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "Авторизация"
        ],
        "summary": "Revoke current device token",
        "operationId": "logoutCurrentDevice",
        "description": "Requires Bearer token with auth:logout. Other device tokens are not revoked.",
        "security": [
          {
            "sanctumBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResponse"
                }
              }
            }
          },
          "401": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sanctumBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Sanctum"
      }
    },
    "schemas": {
      "Venue": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "alias": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "type_label": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "operational_status": {
            "type": "string"
          },
          "short_description": {
            "type": [
              "string",
              "null"
            ]
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "latitude": {
            "type": [
              "number",
              "null"
            ]
          },
          "longitude": {
            "type": [
              "number",
              "null"
            ]
          },
          "image_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "alias",
          "type",
          "type_label",
          "status",
          "operational_status",
          "short_description",
          "address",
          "latitude",
          "longitude",
          "image_url",
          "url"
        ]
      },
      "CursorMeta": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer"
          },
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "limit",
          "has_more",
          "next_cursor"
        ]
      },
      "VenuePage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Venue"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/CursorMeta"
          },
          "links": {
            "type": "object",
            "properties": {
              "next": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "next"
            ]
          }
        },
        "required": [
          "data",
          "meta",
          "links"
        ]
      },
      "MapSurface": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "value",
          "label"
        ]
      },
      "MapVenue": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string"
          },
          "image_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "latitude": {
            "type": [
              "number",
              "null"
            ]
          },
          "longitude": {
            "type": [
              "number",
              "null"
            ]
          },
          "district": {
            "type": [
              "string",
              "null"
            ]
          },
          "surfaces": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MapSurface"
            }
          },
          "amenities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "address",
          "url",
          "image_url",
          "latitude",
          "longitude",
          "district",
          "surfaces",
          "amenities"
        ]
      },
      "MapPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MapVenue"
            }
          },
          "maps_api_key": {
            "type": "string"
          },
          "meta": {
            "$ref": "#/components/schemas/CursorMeta"
          }
        },
        "required": [
          "data",
          "maps_api_key",
          "meta"
        ]
      },
      "TournamentPreview": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "format": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "date",
          "format",
          "url"
        ]
      },
      "TournamentsScene": {
        "type": "object",
        "properties": {
          "assets": {
            "type": "object",
            "properties": {
              "background": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rim": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ball": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "background",
              "rim",
              "ball"
            ]
          },
          "tournaments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TournamentPreview"
            }
          }
        },
        "required": [
          "assets",
          "tournaments"
        ]
      },
      "OwnProfile": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "middle_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "gender": {
            "type": [
              "string",
              "null"
            ]
          },
          "birth_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "avatar_url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "first_name",
          "last_name",
          "middle_name",
          "gender",
          "birth_date",
          "avatar_url"
        ]
      },
      "OwnUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "profile": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/OwnProfile"
              },
              {
                "type": "null"
              }
            ]
          },
          "participation_roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "username",
          "status",
          "profile",
          "participation_roles"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string",
            "minLength": 3,
            "maxLength": 255,
            "example": "test_user"
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true
          },
          "device_name": {
            "type": "string",
            "maxLength": 80,
            "example": "ios-test-device"
          }
        },
        "required": [
          "login",
          "password"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token_type": {
            "type": "string",
            "const": "Bearer"
          },
          "access_token": {
            "type": "string"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "requires_password_change": {
            "type": "boolean"
          },
          "user": {
            "$ref": "#/components/schemas/OwnUser"
          }
        },
        "required": [
          "token_type",
          "access_token",
          "expires_at",
          "requires_password_change",
          "user"
        ]
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/OwnUser"
          }
        },
        "required": [
          "data"
        ]
      },
      "LogoutResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "message"
        ]
      }
    }
  }
}
