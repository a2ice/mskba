        "operationId": "rollbackPageBuilderAgentField",
        "summary": "Откатить опубликованный CSS/JS",
        "description": "Только DEV. Способность page-builder:publish, соответствующие permissions, действующий previous slot. Откат HTML через API не поддерживается (используется история Filament). Перед откатом проверяется SHA-256 опубликованной версии.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PageBuilderAgentRollbackRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Текущее состояние всех draft/published источников и контрольные SHA-256",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageBuilderAgentResponse"
                }
              }
            }
          },
          "401": {
            "description": "Неавторизован: отсутствует либо недействителен Bearer-токен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Не тот тип токена, роль или недостаточные permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Не DEV/staging, несуществующий объект или закрытый маршрут",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Содержимое Filament изменилось либо публикация не допускается без разрешения конфликта",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Ошибка валидации запроса или запрещённое содержимое",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "429": {
            "description": "Превышен лимит запросов",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
